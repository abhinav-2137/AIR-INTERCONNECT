{
  "name": "air-interconnect",
  "version": "1.0.0",
  "description": "CONNEXT — Next-Gen Enterprise Desktop Communication & Collaboration Platform",
  "main": "dist/main.js",
  "scripts": {
    "dev:frontend": "vite",
    "dev:electron": "tsc && electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "build:frontend": "vite build",
    "build:electron": "node scripts/generate-env-config.js && tsc",
    "build": "npm run build:frontend && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mw",
    "test:reset-db": "node tools/reset-db.js",
    "start": "electron ."
  },
  "build": {
    "appId": "com.yourname.airinterconnect",
    "productName": "Air Interconnect",
    "files": [
      "dist/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/dev-data/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/logo.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^5.6.205",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.330.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.0"
  }
}
